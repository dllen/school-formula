{
  "name": "pi-agent-edu",
  "version": "1.0.0",
  "description": "交互式 CLI 工具，通过 pi agent 生成中小学教育资源",
  "type": "module",
  "bin": {
    "pi-agent-edu": "./index.ts"
  },
  "scripts": {
    "dev": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test *.test.ts",
    "gen:dsl": "./pi-agent-edu.sh",
    "gen:new": "./pi-agent-edu.sh --new",
    "gen:continue": "./pi-agent-edu.sh --continue",
    "gen:sessions": "./pi-agent-edu.sh --sessions",
    "gen:help": "./pi-agent-edu.sh --help"
  },
  "dependencies": {
    "typebox": "^1.3.33"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
